# Settings for the Docker Compose deployment (compose.yaml). Copy to .env next to compose.yaml and replace
# every placeholder. Never commit .env.
NODE_ENV=production
UPLOAD_STORAGE=s3
UPLOAD_HOST=0.0.0.0
PORT=8788
STDB_HTTP_URL=https://maincloud.spacetimedb.com
STDB_DATABASE=YOUR_DATABASE
UPLOAD_ALLOWED_ORIGINS=https://YOUR-WEB-APP-ORIGIN

S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=YOUR_BUCKET
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
ASSET_BASE_URL=https://assets.your-domain.example
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same value across restarts and replicas so pending uploads can complete.
UPLOAD_SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Reuse the reconstruction worker's stable identity, without 0x. Its token stays on the worker.
PIPELINE_IDENTITY=REPLACE_WITH_64_HEX_CHARACTERS

# Only used by the optional Docker Compose + Caddy HTTPS setup. You must control this DNS name.
UPLOAD_DOMAIN=api.your-domain.example
