# Settings for `npm run upload:dev` (server/upload/service.mjs, S3/R2 storage).
# Copy to server/upload/.env. Server-only: never prefix storage credentials or tokens with VITE_.

# The SpacetimeDB server and database the browser uses (default port 3055, STDB_PORT).
STDB_HTTP_URL=http://127.0.0.1:3055
STDB_DATABASE=memory-replay
# For the default Vite /stdb proxy, match the origin used in the browser:
# ACCOUNT_SERVER_URL=https://localhost:5173/stdb
# Keep unset when the browser connects directly to STDB_HTTP_URL.

# The pipeline worker's identity: 64 hex characters, without 0x. Mint it once:
#   curl -sX POST $STDB_HTTP_URL/v1/identity   ->  {"identity":"c200…","token":"eyJ…"}
# Put "identity" here. "token" is the worker's PIPELINE_TOKEN (scripts/pipeline-status.py):
# keep it on the worker host only; this service never needs it. Uploads are assigned to this
# identity. Test uploads (presign with "pipeline": false: the capture simulation and
# `npm run test:video`) are assigned to their uploader, so the worker never takes them.
# (`npm run upload:local` mints its own worker identity on first start and keeps it, token
# included, in data/uploads/.worker-identity.json.)
PIPELINE_IDENTITY=replace-with-worker-identity-64-hex-characters

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=memory-replay
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Public URL of the bucket. Memory rows get sourceUrl = ASSET_BASE_URL/videos/<owner>/<uuid>.<ext>.
# Any client can register a memory with any sourceUrl, so the worker must download only URLs
# under ASSET_BASE_URL (upload:local: under PUBLIC_ORIGIN/api/local-media/), whose key names
# the row's owner, capped at 2 GiB and a few minutes, without following redirects.
# scripts/source_check.py has the check: allowed_source(url, base, owner).
ASSET_BASE_URL=https://assets.example.com
# Keep this stable: it also encrypts the persistent six-digit password registry.
UPLOAD_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional dedicated private bucket for encrypted account records (defaults to S3_BUCKET):
# ACCOUNT_PASSWORD_BUCKET=memos-private-accounts
UPLOAD_ALLOWED_ORIGINS=https://localhost:5173,https://YOUR-TUNNEL.trycloudflare.com
# Vite proxies /api to 127.0.0.1:$UPLOAD_PORT (default 8788).
UPLOAD_PORT=8788

# Check the configured service and required DB tables:
#   npm run connections:check -- http://127.0.0.1:8788
# This reports I3/I4/I5/I7 access points without claiming the GPU/bucket is working.
# Local-disk mode only (npm run upload:local), not used by S3 mode:
# LOCAL_UPLOAD_DIR=data/uploads
# LOCAL_SCENE_DIR=data/uploads/memories
# PUBLIC_ORIGIN=http://127.0.0.1:5173
# Run npm run worker:env:local with matching settings to create data/worker.local.env.
