# Store at /root/memos-worker.env (chmod 600); symlink /workspace/memos-worker.env
# to it. Some RunPod network volumes ignore chmod. Never commit real tokens.
export STDB_HTTP_URL=https://maincloud.spacetimedb.com
export STDB_DATABASE=jerry-memory-replay-phone-20261024
export MEMREPLAY_UPLOAD_API=https://memos.alightdell64.chatgpt.site
export ASSET_BASE_URL=https://memos.alightdell64.chatgpt.site/media
export MEMREPLAY_WORK=/workspace/work
# This is a SpacetimeDB worker credential, NOT a Runpod API key or a user's personal key.
export PIPELINE_IDENTITY=REPLACE_WITH_WORKER_IDENTITY
export PIPELINE_TOKEN=REPLACE_WITH_WORKER_TOKEN
