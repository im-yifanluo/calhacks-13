# Copy to data/runpod-account/ssh.env (ignored by git).
# Get the direct IP and port from `runpodctl ssh info YOUR_POD_ID`.
# Refresh them after a restart. Never put the API key or private key contents here.
export MEMREPLAY_SSH_HOST=REPLACE_WITH_DIRECT_SSH_IP
export MEMREPLAY_SSH_PORT=REPLACE_WITH_DIRECT_SSH_PORT
export MEMREPLAY_SSH_KEY=/absolute/path/to/memos-worker-ed25519
export MEMREPLAY_REMOTE_REPO=/workspace/memory-replay
export MEMREPLAY_REMOTE_WORK=/workspace/work
