# Public build settings of the hosted memos site, loaded by `vite build --mode hosted`
# (scripts/deploy/build-hosted-web.mjs) and used as defaults by the suites in tests/e2e/.
# These values are compiled into the page: never put storage credentials or tokens here.
VITE_STDB_URL=wss://maincloud.spacetimedb.com
VITE_STDB_DATABASE=jerry-memory-replay-phone-20261024
VITE_UPLOAD_API=https://memos.alightdell64.chatgpt.site
# Scene records saved before the site was renamed still point at its former origin.
VITE_ASSET_ORIGIN_ALIASES=https://jerry-memory-replay-phone.alightdell64.chatgpt.site
