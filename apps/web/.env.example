# Public build-time values only; never add storage credentials or worker tokens here.
VITE_STDB_DATABASE=memory-replay
# Leave unset for same-origin /stdb/ and /api proxy routes.
# VITE_STDB_URL=wss://YOUR-STDB-HOST/
# VITE_UPLOAD_API=https://YOUR-UPLOAD-HOST
# Optional comma-separated former app origins after a hostname rename. Only list origins
# whose assets now live at this app's current origin; external asset hosts are unchanged.
# VITE_ASSET_ORIGIN_ALIASES=https://OLD-APP-HOST
