{
  "name": "memory-replay",
  "private": true,
  "version": "0.1.0",
  "description": "Relive memories: Meta glasses video -> 4D scene -> multiplayer WebXR on Quest 3S and phones",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stdb:start": "spacetime start --listen-addr 127.0.0.1:${STDB_PORT:-3055}",
    "stdb:build": "spacetime build --module-path server/spacetime",
    "stdb:publish:local": "spacetime publish -s http://127.0.0.1:${STDB_PORT:-3055} --module-path server/spacetime memory-replay",
    "stdb:generate": "spacetime generate --module-path server/spacetime --lang typescript --out-dir apps/web/src/module_bindings --yes",
    "upload:local": "UPLOAD_STORAGE=local node server/upload/src/node/server.mjs",
    "upload:dev": "node --env-file=server/upload/.env server/upload/src/node/server.mjs",
    "upload:start": "node server/upload/src/node/server.mjs",
    "party:dev": "node scripts/dev/party-dev.mjs",
    "party:lan": "node scripts/dev/party-dev.mjs --lan",
    "tunnel": "cloudflared tunnel --url https://localhost:5173 --no-tls-verify",
    "worker:env:local": "node scripts/dev/local-worker-env.mjs",
    "connections:check": "node scripts/dev/check-connections.mjs",
    "test:integration": "tsx tests/integration/multiplayer.ts",
    "test:party": "tsx tests/integration/party.ts",
    "test:adapter": "tsx tests/integration/adapter.ts",
    "test:connections": "tsx tests/integration/connections.ts",
    "test:upload-api": "tsx tests/integration/upload-api.ts",
    "test:video": "tsx tests/integration/video.ts",
    "test:pipeline": "node tests/integration/ios-pipeline.mjs",
    "test:pipeline:live": "tsx tests/e2e/pipeline-live.ts",
    "ios:generate": "python3 apps/ios/scripts/generate_xcode_project.py",
    "ios:demo:build": "xcodebuild -project apps/ios/SceneCaptureDemo.xcodeproj -scheme SceneCaptureDemo -configuration Debug -sdk iphonesimulator -derivedDataPath /tmp/memreplay-ios-demo build"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "17.13.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "4.92.0",
    "ws": "^8.22.0"
  }
}
