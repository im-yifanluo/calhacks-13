{
  "name": "memory-replay",
  "private": true,
  "version": "0.1.0",
  "description": "Relive memories: Meta glasses video -> 4D scene -> multiplayer WebXR on Quest 3S and phones",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "vitest run && npm run test -w apps/web",
    "typecheck": "tsc -p server/spacetime/tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "stdb:start": "spacetime start --listen-addr 127.0.0.1:${STDB_PORT:-3055}",
    "stdb:build": "spacetime build --module-path server/spacetime",
    "stdb:publish:local": "spacetime publish -s http://127.0.0.1:${STDB_PORT:-3055} --module-path server/spacetime memory-replay",
    "stdb:generate": "spacetime generate --module-path server/spacetime --lang typescript --out-dir apps/web/src/module_bindings --yes",
    "test:integration": "tsx scripts/test-multiplayer.ts",
    "test:video": "tsx scripts/test-video.ts",
    "upload:local": "node server/upload/local.mjs",
    "upload:dev": "node --env-file=server/upload/.env server/upload/service.mjs",
    "tunnel": "cloudflared tunnel --url https://localhost:5173 --no-tls-verify",
    "ios:generate": "python3 scripts/generate_xcode_project.py",
    "ios:demo:build": "xcodebuild -project apps/ios/SceneCaptureDemo.xcodeproj -scheme SceneCaptureDemo -configuration Debug -sdk iphonesimulator -derivedDataPath /tmp/memreplay-ios-demo build",
    "test:party": "tsx scripts/test-party.ts",
    "party:dev": "node scripts/party-dev.mjs",
    "party:lan": "node scripts/party-dev.mjs --lan"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "ws": "^8.22.0"
  }
}
